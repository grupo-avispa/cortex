#!/usr/bin/env python3

from setuptools import find_packages, setup

# Package metadata
setup(
    name='pydsr',
    version='@PROJECT_VERSION@',
    author='Robocomp Team',
    author_email='robocomp.team@gmail.com',
    description='@PROJECT_DESCRIPTION@',
    long_description='Python bindings for DSR (Distributed Scene Representation) library',
    long_description_content_type='text/plain',
    url='https://github.com/robocomp/robocomp',
    packages=find_packages(),

    # Include the compiled extension
    package_data={
        '': ['pydsr@PYTHON_MODULE_EXTENSION@'],
    },
    include_package_data=True,
    zip_safe=False,

    # Requirements
    python_requires='>=3.10',

    # Entry points (if any)
    entry_points={},

    # Additional metadata
    keywords='robotics, graph, distributed, scene-representation',
    project_urls={
        'Bug Reports': 'https://github.com/robocomp/robocomp/issues',
        'Source': 'https://github.com/robocomp/robocomp',
    },
)
